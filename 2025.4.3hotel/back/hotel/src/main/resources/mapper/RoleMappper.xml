<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.example.hotel_back.mapper.RoleMapper">

    <select id="getAllRoles" resultType="com.example.hotel_back.Pojo.VO.RoleNameVO">
        SELECT
            id,
            role_name
        FROM role
        WHERE status = 1
        ORDER BY id ASC
    </select>

</mapper>
